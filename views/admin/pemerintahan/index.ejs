<%# views/admin/pemerintahan/index.ejs — Manajemen Perangkat Desa %>

<% if (flash) { %>
<div class="alert alert-<%= flash.type === 'success' ? 'success' : 'error' %>">
  <%= flash.msg %>
</div>
<% } %>

<div class="admin-card">
  <!-- Header: judul + tombol tambah + search -->
  <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px; flex-wrap:wrap; gap:12px;">
    <p class="admin-card-title" style="margin:0;">Daftar Perangkat Desa</p>
    <div style="display:flex; gap:10px; align-items:center; flex-wrap:wrap;">
      <!-- Search filter (client-side) -->
      <input
        type="text"
        id="search-perangkat"
        class="form-control"
        placeholder="🔍 Cari nama / jabatan..."
        oninput="filterPerangkat()"
        style="width:220px; padding:7px 12px;"
        autocomplete="off"
      />
      <a href="/admin/pemerintahan/tambah" class="btn btn-primary" id="btn-tambah-perangkat">
        + Tambah Perangkat
      </a>
    </div>
  </div>

  <!-- Stats mini -->
  <div style="display:flex; gap:10px; margin-bottom:16px; flex-wrap:wrap;">
    <span class="badge badge-blue" style="font-size:12px; padding:5px 12px;">
      Total: <%= daftarPerangkat.length %> orang
    </span>
    <span class="badge badge-green" style="font-size:12px; padding:5px 12px;">
      Aktif: <%= daftarPerangkat.filter(p => p.aktif).length %>
    </span>
    <span class="badge badge-gray" style="font-size:12px; padding:5px 12px;">
      Nonaktif: <%= daftarPerangkat.filter(p => !p.aktif).length %>
    </span>
  </div>

  <!-- Tabel -->
  <% if (daftarPerangkat.length === 0) { %>
  <!-- Empty state -->
  <div style="text-align:center; padding:48px 16px; color:#94a3b8;">
    <div style="font-size:48px; margin-bottom:12px;">🏛️</div>
    <p style="font-weight:600; font-size:14px; color:#64748b; margin-bottom:6px;">Belum ada data perangkat desa</p>
    <p style="font-size:13px; margin-bottom:20px;">Tambahkan data perangkat desa untuk menampilkannya di halaman publik.</p>
    <a href="/admin/pemerintahan/tambah" class="btn btn-primary">+ Tambah Perangkat Pertama</a>
  </div>
  <% } else { %>
  <div style="overflow-x:auto;">
    <table class="admin-table" id="tabel-perangkat">
      <thead>
        <tr>
          <th style="width:56px;">Foto</th>
          <th>Nama</th>
          <th>Jabatan</th>
          <th style="width:70px;">Urutan</th>
          <th style="width:90px;">Status</th>
          <th style="width:180px;">Aksi</th>
        </tr>
      </thead>
      <tbody id="tbody-perangkat">
        <% daftarPerangkat.forEach(p => { %>
        <tr data-nama="<%= p.nama.toLowerCase() %>" data-jabatan="<%= p.jabatan.toLowerCase() %>">
          <!-- Foto -->
          <td>
            <% if (p.foto_url) { %>
              <img
                src="<%= p.foto_url %>"
                alt="<%= p.nama %>"
                style="width:44px; height:44px; border-radius:50%; object-fit:cover; border:2px solid #e2e8f0;"
              />
            <% } else { %>
              <div style="width:44px; height:44px; border-radius:50%; background:#f1f5f9; display:flex; align-items:center; justify-content:center; color:#94a3b8; font-size:18px; border:2px solid #e2e8f0;">
                👤
              </div>
            <% } %>
          </td>

          <!-- Nama -->
          <td style="font-weight:500; color:#1e293b; font-size:13px;">
            <%= p.nama %>
          </td>

          <!-- Jabatan -->
          <td style="color:#64748b; font-size:13px;">
            <%= p.jabatan %>
          </td>

          <!-- Urutan -->
          <td style="text-align:center; color:#64748b; font-size:13px;">
            <%= p.urutan %>
          </td>

          <!-- Status -->
          <td>
            <span class="badge <%= p.aktif ? 'badge-green' : 'badge-gray' %>">
              <%= p.aktif ? 'Aktif' : 'Nonaktif' %>
            </span>
          </td>

          <!-- Aksi -->
          <td>
            <div style="display:flex; gap:6px; flex-wrap:wrap;">
              <a
                href="/admin/pemerintahan/<%= p.id %>/edit"
                class="btn btn-secondary btn-sm"
                id="btn-edit-perangkat-<%= p.id %>"
              >✏️ Edit</a>

              <!-- Toggle aktif/nonaktif -->
              <form action="/admin/pemerintahan/<%= p.id %>/toggle" method="POST" style="display:inline;">
                <button
                  type="submit"
                  class="btn btn-sm"
                  style="background:<%= p.aktif ? '#fef9c3' : '#dcfce7' %>; color:<%= p.aktif ? '#ca8a04' : '#16a34a' %>;"
                  title="<%= p.aktif ? 'Nonaktifkan' : 'Aktifkan' %>"
                  id="btn-toggle-perangkat-<%= p.id %>"
                >
                  <%= p.aktif ? '🔇 Nonaktif' : '✅ Aktif' %>
                </button>
              </form>

              <!-- Hapus dengan konfirmasi -->
              <form
                action="/admin/pemerintahan/<%= p.id %>/hapus"
                method="POST"
                onsubmit="return confirmHapus('<%= p.nama %>')"
                style="display:inline;"
              >
                <button
                  type="submit"
                  class="btn btn-danger btn-sm"
                  id="btn-hapus-perangkat-<%= p.id %>"
                >🗑 Hapus</button>
              </form>
            </div>
          </td>
        </tr>
        <% }); %>
      </tbody>
    </table>
  </div>

  <!-- Empty state saat filter tidak menemukan hasil -->
  <div id="no-results" style="display:none; text-align:center; padding:32px; color:#94a3b8; font-size:13px;">
    Tidak ada perangkat yang sesuai dengan pencarian.
  </div>
  <% } %>
</div>

<!-- Info: hubungan dengan halaman publik -->
<div class="admin-card" style="background:#f0fdf4; border-color:#bbf7d0;">
  <div style="display:flex; align-items:flex-start; gap:12px;">
    <span style="font-size:20px;">🌐</span>
    <div>
      <p style="font-weight:600; font-size:13px; color:#16a34a; margin:0 0 4px;">Terhubung dengan Halaman Publik</p>
      <p style="font-size:12px; color:#4ade80; margin:0;">
        Data yang Anda kelola di sini akan langsung tampil di halaman
        <a href="/pemerintahan" target="_blank" style="color:#16a34a; font-weight:600;">
          /pemerintahan ↗
        </a>
        pada website publik. Hanya perangkat dengan status <strong>Aktif</strong> yang akan ditampilkan.
      </p>
    </div>
  </div>
</div>

<script>
// Client-side search filter
function filterPerangkat() {
  const q = document.getElementById('search-perangkat').value.toLowerCase().trim();
  const rows = document.querySelectorAll('#tbody-perangkat tr');
  let visibleCount = 0;

  rows.forEach(row => {
    const nama = row.dataset.nama || '';
    const jabatan = row.dataset.jabatan || '';
    const match = nama.includes(q) || jabatan.includes(q);
    row.style.display = match ? '' : 'none';
    if (match) visibleCount++;
  });

  const noResults = document.getElementById('no-results');
  if (noResults) {
    noResults.style.display = (visibleCount === 0 && q !== '') ? 'block' : 'none';
  }
}

// Konfirmasi dialog sebelum hapus
function confirmHapus(nama) {
  return confirm(`Hapus perangkat "${nama}"?\n\nData yang sudah dihapus tidak dapat dikembalikan.`);
}

// Auto-dismiss alert setelah 4 detik
document.addEventListener('DOMContentLoaded', () => {
  const alerts = document.querySelectorAll('.alert');
  alerts.forEach(el => {
    setTimeout(() => {
      el.style.transition = 'opacity 0.4s';
      el.style.opacity = '0';
      setTimeout(() => el.remove(), 400);
    }, 4000);
  });
});
</script>
