<%# views/public/profil.ejs — Halaman Profil Desa %>
  <% function p(k){return(profil[k]&&profil[k].konten&&profil[k].konten.trim())?profil[k].konten.trim():'';} %>
    <% function pj(k){var r=p(k);if(!r)return[];try{return JSON.parse(r);}catch(e){return[];}} %>
      <% var sejarah=p('sejarah'); %>
        <% var visi=p('visi'); %>
          <% var misi=p('misi'); %>
            <% var letakGeografis=p('letak_geografis'); %>
              <% var batasWilayah=p('batas_wilayah'); %>
                <% var orbitasi=pj('orbitasi'); %>
                  <% var saranaPrasarana=pj('sarana_prasarana'); %>
                    <% var mapsUrl=p('maps'); %>

                      <section class="bg-gradient-to-r from-primary-700 to-primary-900 text-white py-14 px-4">
                        <div class="max-w-7xl mx-auto">
                          <p class="text-primary-200 text-sm mb-2">&#8592; <a href="/"
                              class="hover:underline">Beranda</a></p>
                          <h1 class="text-3xl md:text-4xl font-bold">Profil Desa</h1>
                          <p class="text-primary-200 mt-2">
                            <%= desa.nama %>, Kec. <%= desa.kecamatan %>, Kab. <%= desa.kabupaten %>
                          </p>
                        </div>
                      </section>

                      <style>
                        .pcard {
                          background: #fff;
                          border-radius: 14px;
                          border: 1px solid #e2e8f0;
                          padding: 24px 26px;
                          box-shadow: 0 1px 6px rgba(0, 0, 0, .04);
                          margin-bottom: 24px;
                        }

                        .ptitle {
                          font-size: 17px;
                          font-weight: 700;
                          color: #1e293b;
                          display: flex;
                          align-items: center;
                          gap: 10px;
                          margin: 0 0 16px;
                        }

                        .ptitle .pico {
                          width: 34px;
                          height: 34px;
                          border-radius: 9px;
                          background: #f0fdf4;
                          border: 1.5px solid #bbf7d0;
                          display: flex;
                          align-items: center;
                          justify-content: center;
                          font-size: 16px;
                          flex-shrink: 0;
                        }

                        .pkosong {
                          color: #94a3b8;
                          font-style: italic;
                          font-size: 13px;
                          margin: 0;
                        }

                        .pkode {
                          background: #f1f5f9;
                          padding: 1px 5px;
                          border-radius: 4px;
                          font-size: 11px;
                          font-family: monospace;
                        }

                        .batas-grid {
                          display: grid;
                          grid-template-columns: 1fr 1fr;
                          gap: 10px;
                        }

                        @media(max-width:480px) {
                          .batas-grid {
                            grid-template-columns: 1fr;
                          }
                        }

                        .batas-item {
                          background: #f8fafc;
                          border-radius: 9px;
                          border: 1px solid #e2e8f0;
                          padding: 12px 14px;
                          display: flex;
                          align-items: flex-start;
                          gap: 10px;
                        }

                        .batas-dir {
                          width: 32px;
                          height: 32px;
                          border-radius: 7px;
                          color: #fff;
                          font-size: 11px;
                          font-weight: 800;
                          display: flex;
                          align-items: center;
                          justify-content: center;
                          flex-shrink: 0;
                        }

                        .batas-lbl {
                          font-size: 10px;
                          color: #94a3b8;
                          font-weight: 700;
                          text-transform: uppercase;
                          letter-spacing: .05em;
                          margin-bottom: 3px;
                        }

                        .batas-val {
                          font-size: 13px;
                          color: #334155;
                          font-weight: 500;
                        }

                        .orb-row {
                          display: flex;
                          justify-content: space-between;
                          align-items: center;
                          padding: 10px 0;
                          border-bottom: 1px solid #f1f5f9;
                          gap: 12px;
                        }

                        .orb-row:last-child {
                          border-bottom: none;
                        }

                        .orb-lbl {
                          font-size: 13px;
                          color: #64748b;
                        }

                        .orb-val {
                          font-size: 14px;
                          font-weight: 700;
                          color: #16a34a;
                          white-space: nowrap;
                        }

                        .orb-sat {
                          font-size: 11px;
                          color: #94a3b8;
                          font-weight: 400;
                          margin-left: 3px;
                        }

                        .sarp-tbl {
                          width: 100%;
                          border-collapse: collapse;
                          font-size: 13px;
                        }

                        .sarp-tbl th {
                          text-align: left;
                          padding: 8px 11px;
                          background: #f8fafc;
                          color: #64748b;
                          font-size: 11px;
                          font-weight: 700;
                          text-transform: uppercase;
                          letter-spacing: .05em;
                          border-bottom: 2px solid #e2e8f0;
                        }

                        .sarp-tbl td {
                          padding: 10px 11px;
                          border-bottom: 1px solid #f1f5f9;
                          color: #374151;
                          vertical-align: middle;
                        }

                        .sarp-tbl tr:last-child td {
                          border-bottom: none;
                        }

                        .sarp-tbl tr:hover td {
                          background: #f8fafc;
                        }

                        .kbadge {
                          display: inline-block;
                          font-size: 11px;
                          font-weight: 600;
                          padding: 2px 8px;
                          border-radius: 99px;
                        }

                        .maps-wrap {
                          border-radius: 12px;
                          overflow: hidden;
                          border: 1px solid #e2e8f0;
                        }

                        .maps-wrap iframe {
                          display: block;
                          width: 100%;
                          height: 400px;
                          border: none;
                        }

                        @media(max-width:640px) {
                          .maps-wrap iframe {
                            height: 260px;
                          }
                        }

                        .profil-grid {
                          display: grid;
                          grid-template-columns: 1fr 320px;
                          gap: 24px;
                          align-items: start;
                        }

                        @media(max-width:1024px) {
                          .profil-grid {
                            grid-template-columns: 1fr;
                          }
                        }

                        /* Sarana prasarana 4 kolom */
                        .sarpras-wrap {
                          background: #f8fafc;
                          border-top: 2px solid #e2e8f0;
                          border-bottom: 2px solid #e2e8f0;
                          padding: 28px 0;
                          margin-bottom: 24px;
                        }

                        .sarpras-grid {
                          display: grid;
                          grid-template-columns: repeat(4, 1fr);
                          gap: 14px;
                        }

                        @media(max-width:900px) {
                          .sarpras-grid {
                            grid-template-columns: repeat(2, 1fr);
                          }
                        }

                        @media(max-width:480px) {
                          .sarpras-grid {
                            grid-template-columns: 1fr;
                          }
                        }

                        .sarpras-card {
                          background: #fff;
                          border-radius: 12px;
                          border: 1px solid #e2e8f0;
                          overflow: hidden;
                          box-shadow: 0 1px 4px rgba(0, 0, 0, .04);
                        }

                        .sarpras-head {
                          padding: 10px 14px;
                          border-bottom: 1px solid #e2e8f0;
                        }

                        .sarpras-head p {
                          font-size: 11px;
                          font-weight: 800;
                          text-transform: uppercase;
                          letter-spacing: .08em;
                          margin: 0;
                        }

                        .sarpras-row {
                          display: flex;
                          justify-content: space-between;
                          align-items: center;
                          padding: 7px 14px;
                          border-bottom: 1px solid #f8fafc;
                          font-size: 12px;
                        }

                        .sarpras-row:last-child {
                          border-bottom: none;
                        }

                        .sarpras-row span:first-child {
                          color: #374151;
                          flex: 1;
                          padding-right: 8px;
                        }

                        .sarpras-num {
                          font-weight: 700;
                          color: #1e293b;
                          white-space: nowrap;
                        }

                        .sarpras-sat {
                          font-weight: 400;
                          color: #94a3b8;
                          font-size: 11px;
                          margin-left: 3px;
                        }
                      </style>

                      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
                        <div class="profil-grid">

                          <div>

                            <div class="pcard">
                              <h2 class="ptitle"><span class="pico">&#128220;</span> Sejarah Desa</h2>
                              <% if (sejarah) { %>
                                <div style="color:#4b5563;line-height:1.8;white-space:pre-line;font-size:14px;">
                                  <%= sejarah %>
                                </div>
                                <% } else { %>
                                  <p class="pkosong">Data belum tersedia. Isi kunci <code class="pkode">sejarah</code>
                                    di tabel profil_desa.</p>
                                  <% } %>
                            </div>

                            <div class="pcard">
                              <h2 class="ptitle"><span class="pico">&#127919;</span> Visi &amp; Misi</h2>
                              <% if (visi) { %>
                                <div style="margin-bottom:16px;">
                                  <p
                                    style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.07em;color:#16a34a;margin:0 0 6px;">
                                    VISI</p>
                                  <p
                                    style="color:#334155;font-size:14px;line-height:1.7;font-style:italic;border-left:3px solid #16a34a;padding-left:14px;">
                                    "<%= visi %>"</p>
                                </div>
                                <% } else { %>
                                  <p class="pkosong" style="margin-bottom:12px;">Data visi belum tersedia.</p>
                                  <% } %>
                                    <% if (misi) { %>
                                      <div>
                                        <p
                                          style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.07em;color:#16a34a;margin:0 0 6px;">
                                          MISI</p>
                                        <div style="color:#4b5563;font-size:14px;line-height:1.8;white-space:pre-line;">
                                          <%= misi %>
                                        </div>
                                      </div>
                                      <% } else { %>
                                        <p class="pkosong">Data misi belum tersedia.</p>
                                        <% } %>
                            </div>

                            <div class="pcard">
                              <h2 class="ptitle"><span class="pico">&#127758;</span> Letak Geografis</h2>
                              <% if (letakGeografis) { %>
                                <p style="color:#4b5563;font-size:14px;line-height:1.8;white-space:pre-line;">
                                  <%= letakGeografis %>
                                </p>
                                <% } else { %>
                                  <p class="pkosong">Data belum tersedia. Isi kunci <code
                                      class="pkode">letak_geografis</code> di tabel profil_desa.</p>
                                  <% } %>
                            </div>

                            <div class="pcard">
                              <h2 class="ptitle"><span class="pico">&#129517;</span> Batas Wilayah</h2>
                              <% if (batasWilayah) { %>
                                <% var barisBatas=batasWilayah.split('\n'); %>
                                  <% var arahDef=[{kode:'U',warna:'#16a34a',label:'Sebelah Utara',pfx:['sebelah
                                    utara','utara']},{kode:'S',warna:'#0891b2',label:'Sebelah Selatan',pfx:['sebelah
                                    selatan','selatan']},{kode:'T',warna:'#d97706',label:'Sebelah Timur',pfx:['sebelah
                                    timur','timur']},{kode:'B',warna:'#7c3aed',label:'Sebelah Barat',pfx:['sebelah
                                    barat','barat']}]; %>
                                    <div class="batas-grid">
                                      <% arahDef.forEach(function(a){ %>
                                        <% var nilai='' ; barisBatas.forEach(function(brs){ var
                                          lower=brs.toLowerCase().trim(); a.pfx.forEach(function(pfx){
                                          if(!nilai&&lower.startsWith(pfx)){nilai=brs.replace(/^[^:]+:/,'').trim();} });
                                          }); %>
                                          <div class="batas-item">
                                            <div class="batas-dir" style="background:<%= a.warna %>;">
                                              <%= a.kode %>
                                            </div>
                                            <div>
                                              <div class="batas-lbl">
                                                <%= a.label %>
                                              </div>
                                              <div class="batas-val">
                                                <%= nilai||'—' %>
                                              </div>
                                            </div>
                                          </div>
                                          <% }); %>
                                    </div>
                                    <% } else { %>
                                      <p class="pkosong">Data belum tersedia. Isi kunci <code
                                          class="pkode">batas_wilayah</code> di tabel profil_desa.</p>
                                      <% } %>
                            </div>

                            <div class="pcard">
                              <h2 class="ptitle"><span class="pico">&#128205;</span> Orbitasi</h2>
                              <% if (orbitasi.length> 0) { %>
                                <% orbitasi.forEach(function(o){ %>
                                  <div class="orb-row">
                                    <span class="orb-lbl">
                                      <%= o.label||'—' %>
                                    </span>
                                    <span class="orb-val">
                                      <%= o.nilai||'—' %><span class="orb-sat">
                                          <%= o.satuan||'' %>
                                        </span>
                                    </span>
                                  </div>
                                  <% }); %>
                                    <% } else { %>
                                      <p class="pkosong">Data belum tersedia. Isi kunci <code
                                          class="pkode">orbitasi</code> dengan JSON array di tabel profil_desa.</p>
                                      <% } %>
                            </div>

                          </div>

                          <div>

                            <div class="pcard">
                              <h3 class="ptitle" style="font-size:15px;"><span class="pico"
                                  style="width:30px;height:30px;font-size:14px;">&#128203;</span> Identitas Desa</h3>
                              <dl style="display:flex;flex-direction:column;gap:10px;font-size:13px;">
                                <div>
                                  <dt
                                    style="color:#94a3b8;font-size:11px;text-transform:uppercase;letter-spacing:.05em;">
                                    Nama Desa</dt>
                                  <dd style="font-weight:600;color:#1e293b;margin:2px 0 0;">
                                    <%= desa.nama %>
                                  </dd>
                                </div>
                                <div>
                                  <dt
                                    style="color:#94a3b8;font-size:11px;text-transform:uppercase;letter-spacing:.05em;">
                                    Kecamatan</dt>
                                  <dd style="font-weight:600;color:#1e293b;margin:2px 0 0;">
                                    <%= desa.kecamatan %>
                                  </dd>
                                </div>
                                <div>
                                  <dt
                                    style="color:#94a3b8;font-size:11px;text-transform:uppercase;letter-spacing:.05em;">
                                    Kabupaten</dt>
                                  <dd style="font-weight:600;color:#1e293b;margin:2px 0 0;">
                                    <%= desa.kabupaten %>
                                  </dd>
                                </div>
                                <div>
                                  <dt
                                    style="color:#94a3b8;font-size:11px;text-transform:uppercase;letter-spacing:.05em;">
                                    Provinsi</dt>
                                  <dd style="font-weight:600;color:#1e293b;margin:2px 0 0;">
                                    <%= desa.provinsi %>
                                  </dd>
                                </div>
                              </dl>
                            </div>

                            <div class="pcard">
                              <h3 class="ptitle" style="font-size:15px;"><span class="pico"
                                  style="width:30px;height:30px;font-size:14px;">&#128202;</span> Statistik Desa</h3>
                              <% if (statistik.length===0) { %>
                                <p class="pkosong">Data statistik belum tersedia.</p>
                                <% } else { %>
                                  <% statistik.forEach(function(s){ %>
                                    <div
                                      style="display:flex;justify-content:space-between;align-items:center;padding:8px 0;border-bottom:1px solid #f1f5f9;font-size:13px;">
                                      <span style="color:#64748b;">
                                        <%= s.label %>
                                      </span>
                                      <span style="font-weight:700;color:#1e293b;">
                                        <%= s.nilai %> <span style="color:#94a3b8;font-weight:400;font-size:11px;">
                                            <%= s.satuan||'' %>
                                          </span>
                                      </span>
                                    </div>
                                    <% }); %>
                                      <% } %>
                            </div>

                            <div class="pcard">
                              <h3 style="font-size:13px;font-weight:700;color:#1e293b;margin:0 0 12px;">Halaman Terkait
                              </h3>
                              <div style="display:flex;flex-direction:column;gap:8px;">
                                <a href="/pemerintahan"
                                  style="display:flex;align-items:center;gap:8px;padding:9px 12px;background:#f8fafc;border-radius:8px;border:1px solid #e2e8f0;text-decoration:none;font-size:13px;color:#334155;">&#127963;
                                  Pemerintahan Desa</a>
                                <a href="/potensi"
                                  style="display:flex;align-items:center;gap:8px;padding:9px 12px;background:#f8fafc;border-radius:8px;border:1px solid #e2e8f0;text-decoration:none;font-size:13px;color:#334155;">&#127806;
                                  Potensi Desa</a>
                                <a href="/berita"
                                  style="display:flex;align-items:center;gap:8px;padding:9px 12px;background:#f8fafc;border-radius:8px;border:1px solid #e2e8f0;text-decoration:none;font-size:13px;color:#334155;">&#128240;
                                  Berita &amp; Pengumuman</a>
                              </div>
                            </div>

                          </div>
                        </div>
                      </div>

                      <!-- Sarana dan Prasarana — full width -->
                      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                        <div class="sarpras-wrap">
                          <h2 class="ptitle" style="margin-bottom:18px;"><span class="pico">&#127959;</span> Sarana
                            &amp; Prasarana</h2>
                          <% var adaSarpras=false; %>
                            <% KATEGORI_SARPRAS.forEach(function(kat){ if((sarprasByKategori[kat]||[]).length>0)
                              adaSarpras=true; }); %>
                              <% if (!adaSarpras) { %>
                                <p class="pkosong">Data belum tersedia. Isi melalui Supabase Table Editor pada tabel
                                  <code class="pkode">sarana_prasarana</code>.</p>
                                <% } else { %>
                                  <div class="sarpras-grid">
                                    <% KATEGORI_SARPRAS.forEach(function(kat){ %>
                                      <% var items=sarprasByKategori[kat]||[]; %>
                                        <% var hdrBg='#f0fdf4' ; var hdrClr='#15803d' ; var hdrBdr='#bbf7d0' ;
                                          if(kat==='Pendidikan' ){hdrBg='#eff6ff' ;hdrClr='#1d4ed8' ;hdrBdr='#bfdbfe'
                                          ;}else if(kat==='Ibadah' ){hdrBg='#fdf4ff' ;hdrClr='#7e22ce' ;hdrBdr='#e9d5ff'
                                          ;}else if(kat==='Umum' ){hdrBg='#fff7ed' ;hdrClr='#c2410c' ;hdrBdr='#fed7aa'
                                          ;} %>
                                          <div class="sarpras-card">
                                            <div class="sarpras-head"
                                              style="background:<%= hdrBg %>;border-bottom-color:<%= hdrBdr %>;">
                                              <p style="color:<%= hdrClr %>;">
                                                <%= kat %>
                                              </p>
                                            </div>
                                            <% if(items.length===0){ %>
                                              <p
                                                style="font-size:12px;color:#cbd5e1;font-style:italic;padding:14px;margin:0;">
                                                Belum ada data.</p>
                                              <% }else{ %>
                                                <div>
                                                  <% items.forEach(function(item){ %>
                                                    <div class="sarpras-row">
                                                      <span>
                                                        <%= item.nama %>
                                                      </span>
                                                      <span class="sarpras-num">
                                                        <%= item.jumlah||'0' %><span class="sarpras-sat">
                                                            <%= item.satuan||'unit' %>
                                                          </span>
                                                      </span>
                                                    </div>
                                                    <% }); %>
                                                </div>
                                                <% } %>
                                          </div>
                                          <% }); %>
                                  </div>
                                  <% } %>
                        </div>
                      </div>

                      <!-- Maps full width -->
                      <div style="background:#f8fafc;border-top:1px solid #e2e8f0;padding:48px 0;">
                        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                          <div style="text-align:center;margin-bottom:22px;">
                            <p
                              style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.1em;color:#16a34a;margin-bottom:6px;">
                              Lokasi</p>
                            <h2 style="font-size:20px;font-weight:800;color:#1e293b;margin:0 0 4px;">Peta <%= desa.nama
                                %>
                            </h2>
                            <p style="font-size:13px;color:#94a3b8;margin:0;">Kec. <%= desa.kecamatan %>, Kab. <%=
                                  desa.kabupaten %>
                            </p>
                          </div>
                          <% if (mapsUrl) { %>
                            <div class="maps-wrap"><iframe src="<%= mapsUrl %>" title="Peta Desa" allowfullscreen=""
                                loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe></div>
                            <% } else { %>
                              <div
                                style="background:#fff;border-radius:12px;border:2px dashed #e2e8f0;padding:40px 20px;text-align:center;">
                                <p style="font-size:28px;margin-bottom:8px;">&#128506;</p>
                                <p style="font-size:14px;color:#64748b;font-weight:600;margin-bottom:4px;">Peta belum
                                  dikonfigurasi</p>
                                <p class="pkosong">Isi kunci <code class="pkode">maps</code> di tabel profil_desa dengan
                                  URL embed Google Maps.</p>
                              </div>
                              <% } %>
                        </div>
                      </div>