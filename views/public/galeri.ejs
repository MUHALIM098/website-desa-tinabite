<%# views/public/galeri.ejs — Halaman Galeri Foto %>

<!-- Page Header -->
<section class="bg-gradient-to-r from-primary-700 to-primary-900 text-white py-12 px-4">
  <div class="max-w-7xl mx-auto">
    <p class="text-primary-200 text-sm mb-1">
      ← <a href="/" class="hover:underline">Beranda</a>
    </p>

    <h1 class="text-3xl font-bold">Galeri</h1>

    <p class="text-primary-200 mt-1">
      Dokumentasi kegiatan dan keindahan <%= desa.nama %>
    </p>
  </div>
</section>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">

  <% if (!foto || foto.length === 0) { %>

    <div class="bg-white rounded-xl border border-dashed border-gray-300 p-14 text-center text-gray-400">
      <p class="text-5xl mb-4">🖼️</p>

      <p class="font-semibold text-lg text-gray-500">
        Galeri foto belum tersedia
      </p>

      <p class="text-sm mt-2">
        Foto akan muncul di sini setelah ditambahkan melalui panel admin.
      </p>
    </div>

  <% } else { %>

    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">

      <% foto.forEach(function(f) { %>

        <div
          class="gallery-item group relative bg-gray-100 rounded-xl overflow-hidden aspect-square cursor-pointer hover:shadow-lg transition-shadow"
          data-src="<%= f.foto_url || '' %>"
          data-title="<%= f.judul || '' %>"
          role="button"
          tabindex="0"
          aria-label="Buka foto <%= f.judul || 'galeri' %>"
        >

          <img
            src="<%= f.foto_url || '' %>"
            alt="<%= f.judul || 'Foto galeri' %>"
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
            loading="lazy"
          >

          <% if (f.judul) { %>

            <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/80 to-transparent p-4 opacity-0 group-hover:opacity-100 transition-opacity">
              <p class="text-white text-sm font-semibold">
                <%= f.judul %>
              </p>
            </div>

          <% } %>

        </div>

      <% }); %>

    </div>

  <% } %>

</div>


<!-- Lightbox -->
<div
  id="lightbox"
  class="fixed inset-0 bg-black/90 z-50 hidden items-center justify-center p-4"
  role="dialog"
  aria-modal="true"
>

  <!-- Tombol Tutup -->
  <button
    id="lightbox-close"
    type="button"
    class="absolute top-4 right-4 text-white text-4xl font-bold leading-none hover:text-gray-300 z-10"
    aria-label="Tutup"
  >
    ×
  </button>


  <!-- Foto -->
  <div
    class="max-w-5xl max-h-full flex flex-col items-center"
    onclick="event.stopPropagation()"
  >

    <img
      id="lightbox-img"
      src=""
      alt=""
      class="max-w-full max-h-[80vh] object-contain rounded-lg shadow-2xl"
    >

    <!-- Judul -->
    <p
      id="lightbox-title"
      class="text-white text-center mt-4 text-lg font-semibold"
    ></p>

  </div>

</div>


<script>
document.addEventListener("DOMContentLoaded", function () {

  const lightbox = document.getElementById("lightbox");
  const lightboxImg = document.getElementById("lightbox-img");
  const lightboxTitle = document.getElementById("lightbox-title");
  const closeButton = document.getElementById("lightbox-close");
  const galleryItems = document.querySelectorAll(".gallery-item");


  // Buka foto
  function openLightbox(src, title) {

    if (!src) {
      return;
    }

    lightboxImg.src = src;
    lightboxImg.alt = title || "Foto galeri";
    lightboxTitle.textContent = title || "";

    lightbox.classList.remove("hidden");
    lightbox.classList.add("flex");

    document.body.style.overflow = "hidden";
  }


  // Tutup foto
  function closeLightbox() {

    lightbox.classList.add("hidden");
    lightbox.classList.remove("flex");

    lightboxImg.src = "";
    lightboxTitle.textContent = "";

    document.body.style.overflow = "";
  }


  // Klik foto
  galleryItems.forEach(function (item) {

    item.addEventListener("click", function () {

      const src = item.dataset.src;
      const title = item.dataset.title;

      openLightbox(src, title);
    });


    // Keyboard Enter / Space
    item.addEventListener("keydown", function (event) {

      if (event.key === "Enter" || event.key === " ") {

        event.preventDefault();

        const src = item.dataset.src;
        const title = item.dataset.title;

        openLightbox(src, title);
      }

    });

  });


  // Tombol X
  closeButton.addEventListener("click", function () {
    closeLightbox();
  });


  // Klik area hitam
  lightbox.addEventListener("click", function (event) {

    if (event.target === lightbox) {
      closeLightbox();
    }

  });


  // Tombol Escape
  document.addEventListener("keydown", function (event) {

    if (event.key === "Escape") {
      closeLightbox();
    }

  });

});
</script>