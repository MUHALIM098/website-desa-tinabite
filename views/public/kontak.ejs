<%# views/public/kontak.ejs — Halaman Kontak %>

  <!-- Page Header -->
  <section class="bg-gradient-to-r from-primary-700 to-primary-900 text-white py-12 px-4">
    <div class="max-w-7xl mx-auto">
      <p class="text-primary-200 text-sm mb-1">← <a href="/" class="hover:underline">Beranda</a></p>
      <h1 class="text-3xl font-bold">Kontak</h1>
      <p class="text-primary-200 mt-1">Hubungi Pemerintah <%= desa.nama %>
      </p>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10">

      <!-- Form Kontak -->
      <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-8">
        <h2 class="text-xl font-bold text-gray-800 mb-6">Kirim Pesan</h2>

        <!-- Pesan sukses (setelah redirect) -->
        <% if (typeof statusSukses !=='undefined' && statusSukses) { %>
          <div class="bg-green-50 border border-green-200 rounded-lg p-4 mb-6">
            <p class="text-green-700 font-medium">✅ Pesan Anda berhasil dikirim! Kami akan segera merespons.</p>
          </div>
          <% } %>

            <!-- Pesan error validasi -->
            <% if (typeof error !=='undefined' && error) { %>
              <div class="bg-red-50 border border-red-200 rounded-lg p-4 mb-6">
                <p class="text-red-700 text-sm">⚠️ <%= error %>
                </p>
              </div>
              <% } %>

                <form action="/kontak" method="POST" class="space-y-5" id="kontak-form">
                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                    <div>
                      <label for="nama" class="block text-sm font-medium text-gray-700 mb-1">
                        Nama <span class="text-red-500">*</span>
                      </label>
                      <input type="text" id="nama" name="nama" required
                        value="<%= (typeof formData !== 'undefined' && formData.nama) ? formData.nama : '' %>"
                        class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent transition"
                        placeholder="Nama Anda" />
                    </div>
                    <div>
                      <label for="email" class="block text-sm font-medium text-gray-700 mb-1">Email</label>
                      <input type="email" id="email" name="email"
                        value="<%= (typeof formData !== 'undefined' && formData.email) ? formData.email : '' %>"
                        class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent transition"
                        placeholder="email@contoh.com" />
                    </div>
                  </div>
                  <div>
                    <label for="subjek" class="block text-sm font-medium text-gray-700 mb-1">Subjek</label>
                    <input type="text" id="subjek" name="subjek"
                      value="<%= (typeof formData !== 'undefined' && formData.subjek) ? formData.subjek : '' %>"
                      class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent transition"
                      placeholder="Perihal pesan" />
                  </div>
                  <div>
                    <label for="pesan" class="block text-sm font-medium text-gray-700 mb-1">
                      Pesan <span class="text-red-500">*</span>
                    </label>
                    <textarea id="pesan" name="pesan" required rows="5"
                      class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent transition resize-none"
                      placeholder="Tulis pesan Anda di sini..."><%= (typeof formData !== 'undefined' && formData.pesan) ? formData.pesan : '' %></textarea>
                  </div>
                  <button type="submit" id="submit-btn"
                    class="w-full bg-primary-600 text-white py-3 rounded-lg font-semibold hover:bg-primary-700 transition-colors">
                    Kirim Pesan
                  </button>
                </form>
      </div>

      <!-- Informasi Kontak -->
      <div class="space-y-6">
        <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-7">
          <h2 class="text-xl font-bold text-gray-800 mb-5">Informasi Kantor Desa</h2>
          <ul class="space-y-4 text-sm text-gray-600">
            <li class="flex items-start gap-3">
              <span class="text-xl mt-0.5">📍</span>
              <div>
                <p class="font-medium text-gray-700">Alamat</p>
                <p>
                  <%= desa.nama %>, Kecamatan <%= desa.kecamatan %>
                </p>
                <p>Kabupaten <%= desa.kabupaten %>, <%= desa.provinsi %>
                </p>
              </div>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-xl mt-0.5">📞</span>
              <div>
                <p class="font-medium text-gray-700">Telepon</p>
                <p class="text-gray-400 italic">
                  <%= desa.telepon ? desa.telepon : 'Belum tersedia' %>
                </p>
              </div>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-xl mt-0.5">✉️</span>
              <div>
                <p class="font-medium text-gray-700">Email</p>
                <p class="text-gray-400 italic">
                  <%= desa.email ? desa.email : 'Belum tersedia' %>
                </p>
              </div>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-xl mt-0.5">🕐</span>
              <div>
                <p class="font-medium text-gray-700">Jam Operasional</p>
                <p>Senin – Jumat: 08.00 – 16.00 WITA</p>
              </div>
            </li>
          </ul>
        </div>

        <div class="bg-primary-50 border border-primary-100 rounded-xl p-5 text-sm text-primary-700">
          <p class="font-semibold mb-1">💡 Tips</p>
          <p>Untuk keperluan mendesak, silakan datang langsung ke kantor desa pada jam operasional.</p>
        </div>
      </div>

    </div>
  </div>