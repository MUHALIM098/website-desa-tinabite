<%# views/public/berita.ejs — Halaman Daftar Berita & Pengumuman %>

  <!-- Page Header -->
  <section class="bg-gradient-to-r from-primary-700 to-primary-900 text-white py-12 px-4">
    <div class="max-w-7xl mx-auto">
      <p class="text-primary-200 text-sm mb-1">← <a href="/" class="hover:underline">Beranda</a></p>
      <h1 class="text-3xl font-bold">Berita Desa</h1>
      <p class="text-primary-200 mt-1">Informasi terkini dari <%= desa.nama %>
      </p>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">

  </div>

  <% if (berita.length===0) { %>
    <div class="bg-white rounded-xl border border-dashed border-gray-300 p-14 text-center text-gray-400">
      <p class="text-5xl mb-4">📰</p>
      <p class="font-semibold text-lg text-gray-500">Belum ada berita yang dipublikasikan</p>
      <p class="text-sm mt-2">Berita akan muncul di sini setelah ditambahkan melalui panel admin.</p>
    </div>
    <% } else { %>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <% berita.forEach(b=> { %>
          <a href="/berita/<%= b.slug %>"
            class="group bg-white rounded-xl border border-gray-200 shadow-sm hover:shadow-md overflow-hidden transition-all hover:-translate-y-1">
            <% if (b.foto_url) { %>
              <img src="<%= b.foto_url %>" alt="<%= b.judul %>" class="w-full h-44 object-cover" />
              <% } %>
                <div class="p-5">
                  <span class="text-xs font-semibold px-2 py-1 rounded-full bg-primary-100 text-primary-700">
                    Berita
                  </span>
                  <h2
                    class="font-semibold text-gray-800 mt-3 mb-1 group-hover:text-primary-600 transition-colors line-clamp-2">
                    <%= b.judul %>
                  </h2>
                  <% if (b.ringkasan) { %>
                    <p class="text-sm text-gray-500 line-clamp-2 mb-2">
                      <%= b.ringkasan %>
                    </p>
                    <% } %>
                      <p class="text-xs text-gray-400">
                        <%= formatTanggal(b.published_at) %>
                      </p>
                </div>
          </a>
          <% }); %>
      </div>

      <% } %>
        </div>