<!-- views/partials/header.ejs — Navigasi utama website -->
<header class="bg-white shadow-sm sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">

      <!-- Logo & Nama Desa -->
      <a href="/"
        class="flex items-center gap-3 text-primary-700 font-bold text-lg hover:text-primary-600 transition-colors">
        <% if (typeof logoUrl !== 'undefined' && logoUrl) { %>
        <img src="<%= logoUrl %>" alt="Logo Desa Tinabite"
          style="width:36px; height:36px; border-radius:50%; object-fit:cover; flex-shrink:0;" />
        <% } else { %>
        <div class="w-8 h-8 bg-primary-600 rounded-full flex items-center justify-center text-white text-sm font-bold flex-shrink-0">T</div>
        <% } %>
        <span>Desa Tinabite</span>
      </a>

      <!-- Navigasi Desktop -->
      <nav class="hidden md:flex items-center gap-6 text-sm font-medium text-gray-600">
        <a href="/" class="hover:text-primary-600 transition-colors">Beranda</a>
        <a href="/profil" class="hover:text-primary-600 transition-colors">Profil Desa</a>
        <a href="/pemerintahan" class="hover:text-primary-600 transition-colors">Pemerintahan</a>
        <a href="/potensi" class="hover:text-primary-600 transition-colors">Potensi</a>
        <a href="/berita" class="hover:text-primary-600 transition-colors">Berita</a>
        <a href="/galeri" class="hover:text-primary-600 transition-colors">Galeri</a>
        <a href="/kontak" class="hover:text-primary-600 transition-colors">Kontak</a>
      </nav>

      <!-- Tombol Mobile Menu -->
      <button id="mobile-menu-btn" class="md:hidden p-2 rounded-md text-gray-500 hover:bg-gray-100 transition-colors"
        aria-label="Buka menu">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>

    </div>

    <!-- Navigasi Mobile (tersembunyi secara default) -->
    <div id="mobile-menu" class="hidden md:hidden pb-4 border-t border-gray-100 pt-3">
      <nav class="flex flex-col gap-2 text-sm font-medium text-gray-600">
        <a href="/" class="px-2 py-2 rounded hover:bg-primary-50 hover:text-primary-600 transition-colors">Beranda</a>
        <a href="/profil" class="px-2 py-2 rounded hover:bg-primary-50 hover:text-primary-600 transition-colors">Profil
          Desa</a>
        <a href="/pemerintahan"
          class="px-2 py-2 rounded hover:bg-primary-50 hover:text-primary-600 transition-colors">Pemerintahan</a>
        <a href="/potensi"
          class="px-2 py-2 rounded hover:bg-primary-50 hover:text-primary-600 transition-colors">Potensi</a>
                <a href="/berita"
          class="px-2 py-2 rounded hover:bg-primary-50 hover:text-primary-600 transition-colors">Berita</a>
        <a href="/galeri"
          class="px-2 py-2 rounded hover:bg-primary-50 hover:text-primary-600 transition-colors">Galeri</a>
        <a href="/kontak"
          class="px-2 py-2 rounded hover:bg-primary-50 hover:text-primary-600 transition-colors">Kontak</a>
      </nav>
    </div>
  </div>
</header>