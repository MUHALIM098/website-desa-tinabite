# ============================================================
# TEMPLATE ENVIRONMENT VARIABLES — Website Desa Tinabite
# ============================================================
# INSTRUKSI:
# 1. Salin file ini menjadi .env di root project
#    (cp .env.example .env  atau copy .env.example .env)
# 2. Isi nilai yang sesuai
# 3. JANGAN PERNAH commit file .env ke Git!
# ============================================================

# --- Server ---
PORT=3000
NODE_ENV=development

# --- Supabase ---
# Dapatkan dari: https://supabase.com/dashboard → Project → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- Supabase Storage ---
# Nama bucket yang akan digunakan untuk menyimpan gambar
SUPABASE_STORAGE_BUCKET=desa-tinabite-media

# --- Session / Security (isi dengan string acak yang panjang) ---
SESSION_SECRET=ganti-dengan-string-acak-minimal-32-karakter

# --- App Info ---
APP_NAME=Website Desa Tinabite
APP_URL=http://localhost:3000
